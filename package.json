{
  "name": "voidkagami",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "postinstall": "node packages/tui/native/build.ts",
    "dev": "node packages/cli/src/index.ts",
    "daemon": "node packages/daemon/src/index.ts",
    "desktop": "pnpm --filter @voidkagami/desktop dev",
    "preview:cli": "node packages/cli/scripts/preview.ts",
    "preview:desktop": "node packages/desktop/scripts/preview.ts",
    "check": "tsc --noEmit",
    "build": "node scripts/build.ts",
    "build:desktop": "pnpm --filter @voidkagami/desktop build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
