{
  "name": "@voidkagami/desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "node scripts/build.ts",
    "package": "pnpm --dir ../.. build && pnpm build && electron-builder --dir"
  },
  "devDependencies": {
    "@voidkagami/client": "workspace:*",
    "@voidkagami/protocol": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "app.voidkagami.desktop",
    "productName": "VoidKagami",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/daemon.js",
        "to": "daemon.js"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
